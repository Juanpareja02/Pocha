
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to improve readability and maintainability of the rules.
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isPlayer(gameOrLobby) {
      return isSignedIn() && request.auth.uid in gameOrLobby.data.playerIds;
    }

    function isCreator(lobby) {
      return isSignedIn() && request.auth.uid == lobby.data.creatorId;
    }
    
    /**
     * Helper to check if a user is creating their OWN document.
     */
    function isCreatingOwnDocument() {
      return isSignedIn() && request.resource.data.id == request.auth.uid;
    }

    /**
     * @description Rules for user profile documents.
     */
    match /users/{userId} {
      allow read: if isSignedIn(); // Any signed-in user can read profiles.
      allow create: if isCreatingOwnDocument(); // A user can create their own profile.
      allow update: if isOwner(userId); // A user can update their own profile.
      allow list, delete: if false;
    }

    /**
     * @description Rules for game lobby documents.
     */
    match /gameLobbies/{gameLobbyId} {
      // Create: The creator must be the signed-in user and must be in the player list.
      allow create: if isCreator(request.resource) && isPlayer(request.resource);
      
      // Read: Any player in the lobby can read it.
      allow read: if isPlayer(resource);
      
      // Update: Either a player is joining (arrayUnion) or the server is starting the game.
      allow update: if isSignedIn() || request.auth == null;
      
      // Delete: Only the original creator can delete the lobby.
      allow delete: if isCreator(resource);
      
      // List: Any signed-in user can query lobbies to join by code.
      allow list: if isSignedIn(); 
    }

    /**
     * @description Rules for game documents.
     */
    match /games/{gameId} {
      // Create: Allow the server (auth is null) to create game documents.
      allow create: if request.auth == null;
      
      // Read & Update: Any player in the game can read and update its state.
      allow read, update: if isPlayer(resource);
      
      // Delete: Only the original lobby creator can delete the game.
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/gameLobbies/$(resource.data.lobbyId)).data.creatorId == request.auth.uid;
      
      allow list: if false; // Do not allow listing all games
    }
  }
}
