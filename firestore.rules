
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to improve readability and maintainability of the rules.
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isPlayer(gameOrLobby) {
      return isSignedIn() && request.auth.uid in gameOrLobby.data.playerIds;
    }

    function isCreator(lobby) {
        return isSignedIn() && request.auth.uid == lobby.data.creatorId;
    }

    /**
     * @description Rules for user profile documents.
     * @path /users/{userId}
     * @allow (read, update) A user can read or update their own profile.
     * @allow (create) A user can create their own profile.
     */
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isOwner(userId);
      allow list, delete: if false;
    }

    /**
     * @description Rules for game lobby documents.
     * @path /gameLobbies/{gameLobbyId}
     * @allow (create) Any signed-in user can create a lobby.
     * @allow (read) Any player in the lobby can read its data.
     * @allow (update) Players can be added, and the creator can change the status.
     * @allow (delete) Only the creator can delete the lobby.
     */
    match /gameLobbies/{gameLobbyId} {
      allow create: if isSignedIn() 
                    && request.resource.data.creatorId == request.auth.uid
                    && request.auth.uid in request.resource.data.playerIds;
      allow read: if isPlayer(resource);
      allow update: if isPlayer(resource) // Allows players to join
                    || isCreator(resource); // Allows creator to change status
      allow delete: if isCreator(resource);
      allow list: if false; // Do not allow listing all lobbies
    }

    /**
     * @description Rules for game documents.
     * @path /games/{gameId}
     * @allow (create) Game can only be created by the lobby creator.
     * @allow (read) Any player in the game can read its state.
     * @allow (update) Any player in the game can update it (to make a move).
     * @allow (delete) Only the lobby creator can delete the game.
     */
    match /games/{gameId} {
      allow create: if isSignedIn() && get(/databases/$(database)/documents/gameLobbies/$(request.resource.data.lobbyId)).data.creatorId == request.auth.uid;
      allow read: if isPlayer(resource);
      allow update: if isPlayer(resource);
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/gameLobbies/$(resource.data.lobbyId)).data.creatorId == request.auth.uid;
      allow list: if false; // Do not allow listing all games
    }
  }
}
