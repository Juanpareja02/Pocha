# Copy to server/.env for local development. Never commit the copied file.
APP_ENV=development
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://pocha:pocha@localhost:5432/pocha?schema=public
REDIS_URL=redis://localhost:6379

# Staging gestionado gratuito (no pegues estos valores en Git):
# Windows user variables: POCHA_STAGING_DATABASE_URL / POCHA_STAGING_REDIS_URL
# Development uses the built-in verifier. Staging/production must use external.
AUTH_ISSUER_URL=
AUTH_AUDIENCE=
AUTH_PROVIDER=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=debug
ENABLE_DEBUG_ENDPOINTS=true
USER_STORE=memory
GAME_STORE=memory
ROOM_STORE=memory
SESSION_LOOKUP_STORE=memory
PRESENCE_STORE=memory
CASUAL_QUEUE_STORE=memory
RANKED_QUEUE_STORE=memory
SEASON_STORE=memory
RANKED_STORE=memory
ANALYTICS_PROVIDER=memory
METRICS_ENABLED=false
METRICS_TOKEN=
MINIMUM_SUPPORTED_PROTOCOL_VERSION=1
LATEST_PROTOCOL_VERSION=1
REDIS_KEY_PREFIX=pocha
HEALTH_TIMEOUT_MS=1500
ONLINE_BID_TIMEOUT_MS=20000
ONLINE_PLAY_TIMEOUT_MS=20000
ONLINE_TRUMP_TIMEOUT_MS=15000
ONLINE_DISCONNECT_GRACE_MS=60000
ONLINE_ROUND_RESULT_MS=250

# Staging/production example (use secret storage, not this file):
# APP_ENV=staging|production
# NODE_ENV=production
# DATABASE_URL=postgresql://<user>:<password>@<managed-postgres-host>:5432/<database>?schema=public
# REDIS_URL=rediss://:<password>@<managed-redis-host>:6380
# REDIS_KEY_PREFIX=staging-pocha
# AUTH_PROVIDER=external
# AUTH_ISSUER_URL=https://securetoken.google.com/<firebase-project-id>
# AUTH_AUDIENCE=<firebase-project-id>
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# Render: upload `firebase-service-account.json` as a Secret File and use the
# runtime path `/etc/secrets/firebase-service-account.json` above.
# TRUST_PROXY is automatic on Render (`RENDER=true`); do not set it manually.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# PUBLIC_BASE_URL=https://api.example.com
# ENABLE_DEBUG_ENDPOINTS=false
# USER_STORE=prisma
# GAME_STORE=prisma
# SEASON_STORE=prisma
# RANKED_STORE=prisma
# ROOM_STORE=redis
# SESSION_LOOKUP_STORE=redis
# PRESENCE_STORE=redis
# CASUAL_QUEUE_STORE=redis
# RANKED_QUEUE_STORE=redis
# ANALYTICS_PROVIDER=noop
